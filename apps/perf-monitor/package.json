{
  "name": "mica-perf-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "api": "bun server/index.ts",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "bun test server/store.test.ts",
    "service:install": "bun scripts/install-service.ts",
    "collector:check": "PYTHONDONTWRITEBYTECODE=1 python3 collectors/check.py",
    "collector:install": "bun scripts/install-collector.ts"
  },
  "dependencies": {
    "antd": "^5.27.0",
    "echarts": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
