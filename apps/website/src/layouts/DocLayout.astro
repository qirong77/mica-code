---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { docGroups, docPages } from '../content/docs';
import '../styles/docs.css';
interface Props {
  title: string;
  description?: string;
  active: string;
}
const { title, description, active } = Astro.props;
const base = import.meta.env.BASE_URL;
const index = docPages.findIndex((page) => page.key === active);
const previous = index > 0 ? docPages[index - 1] : undefined;
const next = docPages[index + 1];
const group = docGroups.find((section) => section.items.some((page) => page.key === active));
---

<BaseLayout title={title} description={description}>
  <div class="docs-shell" data-doc-base={base}>
    <aside class="doc-side" aria-label="文档导航">
      <a class="doc-side-head" href={`${base}docs/`} aria-current={active === 'overview' ? 'page' : undefined}>
        <Icon name="book" size={17} />
        使用文档<span>GUIDES</span>
      </a>
      <button class="search-trigger" type="button" aria-haspopup="dialog">
        <Icon name="search" size={15} />
        <span>搜索文档…</span>
        <kbd>⌘ K</kbd>
      </button>
      <details class="doc-navigation" open>
        <summary>
          浏览文档
          <Icon name="chevron" size={14} />
        </summary>
        <nav aria-label="文档章节">
          {docGroups.map((section) => (
            <div class="doc-nav-group">
              <h2>{section.label}</h2>
              <ul>
                {section.items.map((item) => (
                  <li>
                    <a
                      href={`${base}docs/${item.key}/`}
                      class:list={{ active: active === item.key }}
                      aria-current={active === item.key ? 'page' : undefined}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <a class="doc-map-link" href={`${base}architecture/`}>
            <Icon name="branch" size={14} />
            交互架构图
            <Icon name="external" size={11} />
          </a>
        </nav>
      </details>
      <a class="doc-help" href="https://github.com/qirong77/mica-code/issues">
        <span>遇到问题或有改进建议？</span>在 GitHub 反馈
        <Icon name="external" size={11} />
      </a>
    </aside>
    <div class="doc-content">
      <nav class="doc-breadcrumb" aria-label="当前位置">
        <a href={`${base}docs/`}>文档</a>
        <Icon name="chevron" size={10} />
        <span>{group?.label || '概览'}</span>
        {group && (
          <>
            <Icon name="chevron" size={10} />
            <span>{title}</span>
          </>
        )}
      </nav>
      <details class="doc-mobile-toc">
        <summary>
          本页内容
          <Icon name="chevron" size={13} />
        </summary>
        <nav aria-label="本页章节"></nav>
      </details>
      <article class="doc-main">
        <slot />
      </article>
      <div class="doc-edit">
        <span>文档随项目持续更新</span>
        <a
          href={`https://github.com/qirong77/mica-code/edit/main/apps/website/src/pages/docs/${active === 'overview' ? 'index' : active}.astro`}
        >
          编辑此页
          <Icon name="external" size={12} />
        </a>
      </div>
      <nav class="doc-pagination" aria-label="相邻文档">
        {previous ? (
          <a href={`${base}docs/${previous.key}/`}>
            <span>← 上一篇</span>
            <strong>{previous.title}</strong>
          </a>
        ) : (
          <div />
        )}
        {next && (
          <a href={`${base}docs/${next.key}/`} class="next">
            <span>下一篇 →</span>
            <strong>{next.title}</strong>
          </a>
        )}
      </nav>
    </div>
    <aside class="doc-toc" aria-label="本页目录">
      <span>本页内容</span>
      <nav id="page-toc"></nav>
      <a class="toc-top" href="#main">
        回到顶部 ↑
      </a>
    </aside>
  </div>
  <dialog class="search-dialog" aria-label="搜索文档">
    <div class="search-heading">
      <label for="docs-query">
        <Icon name="search" size={17} />
        搜索文档
      </label>
      <button type="button" class="search-close" aria-label="关闭搜索">
        Esc
      </button>
    </div>
    <input id="docs-query" type="search" placeholder="搜索模型、插件、远程访问…" autocomplete="off" />
    <div id="search-results" class="search-results" aria-live="polite"></div>
    <div class="search-footer" role="status">
      搜索标题与正文 · ↑ ↓ 选择 · Enter 打开
    </div>
  </dialog>
  <script>
    import '../scripts/docs';
  </script>
</BaseLayout>
