---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/home.css';
import benchmark from '../../public/benchmark-data.json';
const base = import.meta.env.BASE_URL;
const install = 'curl -fsSL https://github.com/qirong77/mica-code/releases/latest/download/install.sh | sh';
const checks = benchmark.tasks.reduce((sum, task) => sum + task.checks, 0);
const mica = benchmark.results.find((result) => result.name === 'Mica Code')!;
const workflows = [
  {
    icon: 'search',
    number: '01',
    title: '先理解，再动手',
    text: '搜索代码、引用文件、读取项目约定。沿着真实实现追踪问题，让每次修改都有上下文。',
    detail: '代码搜索 · 文件引用 · 网页检索',
  },
  {
    icon: 'terminal',
    number: '02',
    title: '从修改，走到验证',
    text: '编辑文件、运行测试、操作真实终端。需要分工时，委派子代理探索、实现或审查。',
    detail: '代码编辑 · Shell / PTY · 子代理',
  },
  {
    icon: 'branch',
    number: '03',
    title: '随时接手，继续推进',
    text: '运行中补充要求，恢复历史或分叉思路。用会话笔记和记忆，留住下一次还需要的决定。',
    detail: '排队补充 · 会话恢复 · 笔记与记忆',
  },
];
const extensions = [
  {
    icon: 'layers',
    title: '你的模型，你来选',
    text: '接入支持 Chat Completions 或 Responses 的模型服务，选择模型与推理强度。',
    href: 'configuration',
    label: '连接模型',
  },
  {
    icon: 'book',
    title: '把工作方法变成 Skill',
    text: '把代码审查、发布流程和项目经验写成指南，在需要时交给 agent。',
    href: 'extensions',
    label: '使用 Skills 与 MCP',
  },
  {
    icon: 'puzzle',
    title: '让能力按需组合',
    text: '记忆、子会话、自动压缩、运行复盘。通过插件与会话设置调整工作方式。',
    href: 'plugins',
    label: '探索插件',
  },
  {
    icon: 'code',
    title: '融入现有工具链',
    text: '用 exec 驱动一次任务，用 app-server 接入持续会话，消费结构化事件。',
    href: 'headless',
    label: '接入自动化',
  },
];
---

<BaseLayout title="Mica Code">
  <div class="launch-area">
    <section class="hero container">
      <a class="hero-pill" href="https://github.com/qirong77/mica-code">
        <span class="status-dot"></span>开源 AI 编程工作区<span class="pill-divider">/</span>认识 Mica
        <Icon name="arrow" size={13} />
      </a>
      <h1>
        从一个想法，
        <br />
        <span>到可运行的代码。</span>
      </h1>
      <p class="hero-description">
        连接你的模型，走进真实的项目。
        <br />
        从读懂代码、动手修改，到运行验证，把工作接着做完。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}docs/getting-started/`}>
          开始构建
          <Icon name="arrow" size={16} />
        </a>
        <a class="btn" href={`${base}docs/desktop/`}>
          <Icon name="monitor" size={16} />
          探索工作区
        </a>
      </div>
      <div class="install-wrap">
        <button
          class="install-command"
          type="button"
          data-install={install}
          aria-label="复制 Mica CLI 安装命令"
          title="复制安装命令"
        >
          <span class="install-prompt" aria-hidden="true">
            $
          </span>
          <code>{install}</code>
          <Icon name="copy" size={15} />
          <span class="install-feedback sr-only" aria-live="polite"></span>
        </button>
        <span class="install-meta">
          macOS / Linux<span>·</span>Node.js 22+<a href={`${base}docs/getting-started/#从源码运行`}>源码运行 ↗</a>
        </span>
      </div>
    </section>
    <section class="product-preview container" aria-label="产品预览">
      <div class="preview-toolbar">
        <div class="preview-tabs" role="tablist" aria-label="工作区预览">
          <button
            id="tab-workspace"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="preview-workspace"
            data-preview="workspace"
          >
            <Icon name="monitor" size={15} />
            工作区
          </button>
          <button
            id="tab-trace"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="preview-trace"
            tabindex="-1"
            data-preview="trace"
          >
            <Icon name="terminal" size={15} />
            执行过程
          </button>
        </div>
        <span class="preview-live">
          <span class="status-dot"></span>真实界面 · 示例项目
        </span>
      </div>
      <div class="preview-window">
        <div class="window-bar">
          <span class="window-dots">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>mica / task-queue</span>
          <span class="window-tag">YOUR PROJECT. YOUR WORKSPACE.</span>
        </div>
        <div id="preview-workspace" role="tabpanel" aria-labelledby="tab-workspace" class="preview-panel">
          <img
            src={`${base}screenshots/chat.png`}
            width="1440"
            height="900"
            alt="Mica 当前桌面工作区，在示例任务队列项目中完成代码修改并展示验证结果"
            fetchpriority="high"
          />
        </div>
        <div id="preview-trace" role="tabpanel" aria-labelledby="tab-trace" class="preview-panel" hidden>
          <img
            src={`${base}screenshots/turn-log.png`}
            width="1440"
            height="900"
            alt="Mica 的执行过程，展示任务计划、文件读取、代码修改与测试命令"
            loading="lazy"
          />
        </div>
      </div>
      <div class="preview-caption">
        <span>真实运行时 · 脚本化模型响应 · 图中用量为演示值</span>
        <a href={`${base}docs/desktop/`}>
          桌面与浏览器指南
          <Icon name="arrow" size={14} />
        </a>
      </div>
    </section>
    <div class="capability-strip container">
      <span>围绕真实开发构建</span>
      <span>
        <Icon name="terminal" size={15} />
        终端 TUI
      </span>
      <span>
        <Icon name="monitor" size={15} />
        桌面与 Web
      </span>
      <span>
        <Icon name="phone" size={15} />
        手机接续
      </span>
      <span>
        <Icon name="code" size={15} />
        Headless API
      </span>
    </div>
  </div>

  <section class="section container" id="features">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / FROM CONTEXT TO CODE</p>
        <h2>
          让 agent 进入项目，
          <br />
          也让你掌握过程。
        </h2>
      </div>
      <p>
        写代码只是其中一步。
        <br />
        理解、执行、验证与继续，都有对应的工具。
      </p>
    </div>
    <div class="workflow-grid">
      {workflows.map((item) => (
        <article class="workflow">
          <div class="workflow-top">
            <Icon name={item.icon} size={24} />
            <span>{item.number}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="workflow-detail">{item.detail}</span>
        </article>
      ))}
    </div>
    <a class="text-link section-link" href={`${base}docs/workflows/`}>
      看看一次开发任务如何推进
      <Icon name="arrow" size={15} />
    </a>
  </section>

  <section class="cache-section" id="cache">
    <div class="container cache-grid">
      <div class="cache-copy">
        <p class="eyebrow">02 / CACHE-FIRST BY DESIGN</p>
        <h2>
          上下文会积累。
          <br />
          <span>工作不用每次重来。</span>
        </h2>
        <p>
          稳定的指令、工具与历史前缀，让模型服务复用已经处理过的输入。长任务中先清理冗长工具输出，需要时再用摘要整理历史。
        </p>
        <p>关键决定留在会话笔记里，跨会话的约定交给记忆。上下文有限，工作仍能继续。</p>
        <a class="text-link" href={`${base}docs/workflows/`}>
          了解长任务与上下文
          <Icon name="arrow" size={15} />
        </a>
      </div>
      <div
        class="cache-visual"
        role="img"
        aria-label="上下文追加示意：每轮保留稳定的指令与历史前缀，只追加新的输入与工具结果。实际缓存由模型服务决定。"
      >
        <div class="visual-heading">
          <span>
            <Icon name="layers" size={15} />
            CONTEXT / APPEND
          </span>
          <span>01 → 03</span>
        </div>
        <div class="context-row">
          <span>01</span>
          <div>
            <i class="context-base">指令与工具</i>
            <i class="context-history">对话</i>
            <i class="context-new">新输入</i>
          </div>
        </div>
        <div class="context-row">
          <span>02</span>
          <div>
            <i class="context-base">指令与工具</i>
            <i class="context-history history-medium">对话与工具结果</i>
            <i class="context-new">新输入</i>
          </div>
        </div>
        <div class="context-row">
          <span>03</span>
          <div>
            <i class="context-base">指令与工具</i>
            <i class="context-history history-long">持续积累的历史</i>
            <i class="context-new">新输入</i>
          </div>
        </div>
        <div class="context-legend">
          <span>
            <i></i>可复用的前缀
          </span>
          <span>
            <i></i>追加的内容
          </span>
        </div>
        <p>结构示意 · 实际缓存命中由模型服务与请求内容决定</p>
      </div>
    </div>
  </section>

  <section class="section container" id="extensions">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / MAKE IT YOURS</p>
        <h2>
          带上你的模型，
          <br />
          延续你的工作方式。
        </h2>
      </div>
      <p>
        模型、工具和流程各自独立。
        <br />
        按项目需要组合，也可以接入自己的应用。
      </p>
    </div>
    <div class="extension-grid">
      {extensions.map((item) => (
        <a class="extension-card" href={`${base}docs/${item.href}/`}>
          <Icon name={item.icon} size={23} />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span>
            {item.label}
            <Icon name="arrow" size={14} />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="remote-section container">
    <div class="remote-copy">
      <p class="eyebrow">04 / PICK UP WHERE YOU LEFT OFF</p>
      <h2>
        换一个屏幕，
        <br />
        接着刚才的工作。
      </h2>
      <p>桌面与浏览器连接同一运行时，手机也能查看进展、补充要求。代码与命令在开发机上执行，会话跟着项目继续。</p>
      <a class="text-link" href={`${base}docs/remote-access/`}>
        连接开发机与手机
        <Icon name="arrow" size={15} />
      </a>
      <span class="remote-note">支持局域网连接与 Mobile Relay 插件</span>
    </div>
    <div class="remote-visual">
      <div class="remote-terminal">
        <div class="visual-heading">
          <Icon name="monitor" size={17} />
          <span>DEVELOPMENT MACHINE</span>
          <span class="status-dot"></span>
        </div>
        <div class="remote-task">
          <span class="task-icon">
            <Icon name="check" size={17} />
          </span>
          <div>
            <strong>完成修改，运行验证</strong>
            <span>会话、文件与终端保留在开发机</span>
          </div>
        </div>
        <div class="remote-connection">
          <span></span>
          <Icon name="phone" size={19} />
          <span></span>
        </div>
        <div class="remote-device">
          <strong>同一项工作，继续推进。</strong>
          <span>查看进度 · 补充要求 · 恢复会话</span>
        </div>
      </div>
      <span class="visual-caption">跨设备工作流程示意</span>
    </div>
  </section>

  <section class="benchmark-section" id="benchmark">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">05 / MEASURE, THEN IMPROVE</p>
          <h2>把表现放进具体任务里。</h2>
        </div>
        <a class="text-link" href={`${base}docs/benchmark/`}>
          评测方法与数据范围
          <Icon name="external" size={14} />
        </a>
      </div>
      <p class="benchmark-intro">
        在 {benchmark.tasks.length} 项 DeepSWE v1.1 任务上，以 {checks} 个自定义自动化检查观察 agent
        表现。以下为项目自主评测快照。
      </p>
      <div class="benchmark-stats">
        <div>
          <strong>
            {((mica.passed / checks) * 100).toFixed(1)}
            <small>%</small>
          </strong>
          <span>检查项通过率</span>
        </div>
        <div>
          <strong>
            {mica.cachePercent.toFixed(1)}
            <small>%</small>
          </strong>
          <span>输入缓存命中率</span>
        </div>
        <div>
          <strong>
            {benchmark.tasks.length}
            <small> TASKS</small>
          </strong>
          <span>DeepSWE 任务子集</span>
        </div>
        <div class="benchmark-context">
          <span class="mono-label">MODEL CONFIGURATION</span>
          <strong>{benchmark.source.modelConfiguration}</strong>
          <a href={`${base}benchmark-data.json`}>下载汇总数据 ↗</a>
        </div>
      </div>
      <figure class="benchmark-chart">
        <img
          src={`${base}screenshots/eval-benchmark.svg`}
          width="1180"
          height="276"
          alt="五款 agent 的检查项通过率、缓存命中率、耗时与模型请求数对比，图表通过率轴从95%开始"
          loading="lazy"
        />
      </figure>
      <p class="benchmark-note">
        按任务汇总重复运行的中位数。检查项通过率与任务完成率含义不同；评分与效率样本分别聚合，完整统计口径见评测方法。
      </p>
    </div>
  </section>

  <section class="closing container">
    <p class="eyebrow">BUILT IN THE OPEN. READY FOR YOUR NEXT IDEA.</p>
    <h2>下一步，开始构建。</h2>
    <p>连接一个模型，走进你的项目。其余的，在工作中展开。</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={`${base}docs/getting-started/`}>
        阅读快速开始
        <Icon name="arrow" size={16} />
      </a>
      <a class="btn" href="https://github.com/qirong77/mica-code">
        <Icon name="github" size={16} />在 GitHub 上探索
      </a>
    </div>
  </section>
  <script>
    const installButton = document.querySelector<HTMLButtonElement>('[data-install]')!;
    installButton.addEventListener('click', async () => {
      const feedback = installButton.querySelector<HTMLElement>('.install-feedback')!;
      try {
        await navigator.clipboard.writeText(installButton.dataset.install!);
        installButton.classList.add('copied');
        feedback.textContent = '安装命令已复制';
        installButton.setAttribute('aria-label', '安装命令已复制');
      } catch {
        feedback.textContent = '请选中并手动复制安装命令';
      }
      setTimeout(() => {
        installButton.classList.remove('copied');
        installButton.setAttribute('aria-label', '复制 Mica CLI 安装命令');
      }, 2200);
    });
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-preview]')];
    const activate = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
        document.getElementById(item.getAttribute('aria-controls')!)!.hidden = !selected;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next =
          event.key === 'Home'
            ? tabs[0]
            : event.key === 'End'
              ? tabs[tabs.length - 1]
              : tabs[(index + (event.key === 'ArrowLeft' ? -1 : 1) + tabs.length) % tabs.length];
        activate(next);
        next.focus();
      });
    });
  </script>
</BaseLayout>
