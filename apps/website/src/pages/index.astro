---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const workflows = [
  {
    number: '01',
    title: '理解代码，再开始修改',
    text: '搜索项目、引用文件、查看图片。让 agent 沿着真实代码追踪问题，把上下文交给工具。',
    tag: '文件搜索 / @ 引用 / 网页检索',
  },
  {
    number: '02',
    title: '从实现一直走到验证',
    text: '编辑代码、执行测试、运行交互终端。探索、实现和审查可以交给不同的子代理协作完成。',
    tag: 'Shell / PTY / 多 Agent',
  },
  {
    number: '03',
    title: '保留继续工作的余地',
    text: '恢复会话、分叉思路、回退到检查点。长任务中压缩工具输出，保留对话与工作方向。',
    tag: 'Resume / Fork / Rewind / Compact',
  },
];
---

<BaseLayout title="Mica Code">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span>开源 AI coding agent
      </p>
      <h1>
        让思路成为
        <br />
        <span>可运行的代码。</span>
      </h1>
      <p class="hero-description">
        读懂项目，动手修改，运行验证。
        <br class="desktop-break" />
        从终端到桌面，Mica 陪你把工作做完。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}docs/getting-started/`}>
          开始使用 <span>→</span>
        </a>
        <a class="btn btn-ghost" href="https://github.com/qirong77/mica-code">
          查看源代码 ↗
        </a>
      </div>
      <div class="hero-meta">
        <span>缓存优先</span>
        <span>多模型接入</span>
        <span>终端 · 桌面 · 自动化</span>
      </div>
    </div>
    <div class="hero-console" aria-label="安装与使用示例">
      <div class="console-top">
        <span class="console-indicator"></span>
        <span>YOUR TERMINAL, WITH AN AGENT.</span>
        <span>⌘</span>
      </div>
      <pre><code><span class="code-comment"># 安装 Mica Code</span>{'\n'}curl -fsSL https://github.com/qirong77/mica-code/releases/latest/download/install.sh | sh{'\n\n'}<span class="code-comment"># 在你的项目里开始</span>{'\n'}cd your-project{'\n'}<span class="code-command">mica</span></code></pre>
      <div class="console-bottom">
        <span>Node.js 22+ · macOS / Linux</span>
        <a href={`${base}docs/getting-started/`}>安装指南 ↗</a>
      </div>
    </div>
  </section>

  <section class="product-preview container" aria-label="产品预览">
    <div class="preview-label">
      <span>
        <span class="status-dot"></span>同一套能力，更适合你的工作界面
      </span>
      <span class="preview-label-right">MICA CODE / DESKTOP</span>
    </div>
    <figure class="app-frame">
      <div class="frame-bar">
        <span class="window-dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>Mica Code — Workspace</span>
        <span>Agent / Files / Terminal</span>
      </div>
      <img
        src={`${base}screenshots/chat.png`}
        width="1800"
        height="1113"
        alt="Mica 桌面工作区：左侧会话列表，右侧展示代码修改说明与测试结果"
        fetchpriority="high"
      />
    </figure>
    <div class="preview-caption">
      <span>对话、代码、Git 与终端，在一个工作区里。</span>
      <a href={`${base}docs/desktop/`}>了解桌面端 →</a>
    </div>
  </section>

  <section class="section container" id="features">
    <div class="section-heading">
      <div>
        <p class="eyebrow">BUILT FOR THE WHOLE TASK</p>
        <h2>
          不止给出答案，
          <br />
          也把下一步做完。
        </h2>
      </div>
      <p>
        从一次代码探索，到跨越多个回合的开发任务。
        <br />
        工具、会话和协作，围绕实际工作组织。
      </p>
    </div>
    <div class="workflow-grid">
      {workflows.map((item) => (
        <article class="workflow">
          <span class="workflow-number">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <div class="workflow-tag">{item.tag}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="cache-section" id="cache">
    <div class="container cache-grid">
      <div>
        <p class="eyebrow">CACHE-FIRST BY DESIGN</p>
        <h2>
          上下文积累，
          <br />
          不必每次从头开始。
        </h2>
        <p>
          稳定的提示词、工具定义与历史前缀，让模型有机会复用已经处理过的输入。上下文吃紧时，先压缩工具输出，再按需生成摘要。
        </p>
        <a class="text-link" href={`${base}docs/commands/`}>
          了解上下文管理 →
        </a>
      </div>
      <div class="cache-visual">
        <div class="cache-visual-head">
          <span>上下文复用示意</span>
          <span>INPUT PREFIX</span>
        </div>
        <div class="prefix-row">
          <span>回合 01</span>
          <div>
            <i class="prefix-system">指令与工具</i>
            <i class="prefix-history">对话</i>
            <i class="prefix-new">新输入</i>
          </div>
        </div>
        <div class="prefix-row">
          <span>回合 02</span>
          <div>
            <i class="prefix-system">指令与工具</i>
            <i class="prefix-history">历史对话</i>
            <i class="prefix-new">新输入</i>
          </div>
        </div>
        <div class="prefix-row">
          <span>回合 03</span>
          <div>
            <i class="prefix-system">指令与工具</i>
            <i class="prefix-history">历史对话与工具结果</i>
            <i class="prefix-new">新输入</i>
          </div>
        </div>
        <div class="prefix-legend">
          <span>
            <i></i>保持稳定的前缀
          </span>
          <span>
            <i></i>追加的新内容
          </span>
        </div>
        <p>实际缓存命中取决于模型服务、任务与请求内容。</p>
      </div>
    </div>
  </section>

  <section class="section container" id="benchmark">
    <div class="section-heading">
      <div>
        <p class="eyebrow">BENCHMARK</p>
        <h2>把表现放到数据里。</h2>
      </div>
      <p>
        基于 DeepSWE v1.1 的九项软件工程任务。
        <br />
        对照检查项得分、缓存、耗时与模型请求数。
      </p>
    </div>
    <div class="benchmark-summary">
      <div>
        <strong>
          99.0<span>%</span>
        </strong>
        <span>Mica 检查项通过率</span>
      </div>
      <div>
        <strong>
          99.1<span>%</span>
        </strong>
        <span>输入侧缓存命中率</span>
      </div>
      <div>
        <strong>
          86.2<span> min</span>
        </strong>
        <span>所选任务总耗时</span>
      </div>
      <a href={`${base}docs/benchmark/`}>
        查看评测方法
        <br />
        <span>数据范围与指标说明 ↗</span>
      </a>
    </div>
    <figure class="benchmark-chart">
      <img
        src={`${base}screenshots/eval-benchmark.svg`}
        width="1180"
        height="276"
        alt="五种 agent 的检查项通过率、输入缓存命中率、总耗时和总轮次对比，Mica 的通过率为 99.0%、缓存命中率为 99.1%"
        loading="lazy"
      />
    </figure>
    <p class="benchmark-note">
      项目自主评测快照 · 464 个自定义自动化检查项 · 按任务汇总重复运行的中位数。各指标的样本范围与限制见评测说明。
    </p>
  </section>

  <section class="section workspace-section container">
    <div class="workspace-copy">
      <p class="eyebrow">A WORKSPACE THAT FOLLOWS YOU</p>
      <h2>
        专注眼前，
        <br />
        也看得见全局。
      </h2>
      <p>任务计划、工具执行与用量随时可查。旁问、后台任务和子代理各有位置，主线工作持续向前。</p>
      <ul class="feature-list">
        <li>
          <span>01</span>多会话与项目分组，随时恢复工作
        </li>
        <li>
          <span>02</span>文件、Git diff 与终端，就地查看
        </li>
        <li>
          <span>03</span>桌面与浏览器，接入同一运行时
        </li>
      </ul>
      <a class="text-link" href={`${base}docs/desktop/`}>
        探索工作区 →
      </a>
    </div>
    <figure class="workspace-image">
      <img
        src={`${base}screenshots/turn-log.png`}
        width="1800"
        height="1113"
        alt="运行中的 Mica：任务计划、工具调用与回合日志"
        loading="lazy"
      />
      <figcaption>演示环境截图 · 回合日志与任务计划</figcaption>
    </figure>
  </section>

  <section class="integration-section" id="headless">
    <div class="container integration-grid">
      <div>
        <p class="eyebrow">FITS INTO YOUR TOOLCHAIN</p>
        <h2>
          接入你的模型，
          <br />
          融入你的工具链。
        </h2>
        <p>
          选择兼容 OpenAI 协议的模型服务，用 Skills 固化工作方法，用 MCP 连接外部工具。需要自动化时，同一套 agent
          也能由脚本驱动。
        </p>
        <a class="text-link" href={`${base}docs/extensions/`}>
          查看扩展指南 →
        </a>
      </div>
      <div class="integration-links">
        <a href={`${base}docs/configuration/`}>
          <span class="integration-code">01 / MODELS</span>
          <strong>模型与 Provider</strong>
          <span>Chat Completions / Responses ↗</span>
        </a>
        <a href={`${base}docs/extensions/`}>
          <span class="integration-code">02 / EXTENSIONS</span>
          <strong>Skills、MCP 与角色</strong>
          <span>把工作习惯带进 agent ↗</span>
        </a>
        <a href={`${base}docs/headless/`}>
          <span class="integration-code">03 / AUTOMATION</span>
          <strong>Exec 与 App Server</strong>
          <span>JSONL 事件流 / Codex 兼容协议 ↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="closing container">
    <p class="eyebrow">YOUR NEXT BUILD STARTS HERE</p>
    <h2>下一个想法，交给代码。</h2>
    <p>从安装到完成第一个任务，跟着指南开始。</p>
    <a class="btn btn-primary" href={`${base}docs/getting-started/`}>
      阅读快速开始 <span>→</span>
    </a>
    <a class="closing-secondary" href="https://github.com/qirong77/mica-code/releases/latest">
      下载最新版本 ↗
    </a>
  </section>
</BaseLayout>
