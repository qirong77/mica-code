  "cards": [
    {
      "dot": "cyan",
      "title": "入口与界面",
      "items": [
        "交互模式由 Ink TUI 直接驱动同一个 turn loop",
        "headless：mica exec 一次性执行，app-server 常驻讲 Codex v2 协议",
        "命令经 CommandRegistry 分发，busy 时由单槽 message queue 排队"
      ]
    },
    {
      "dot": "emerald",
      "title": "Turn loop 与本地状态",
      "items": [
        "turn 级最多重试 5 次（间隔 10s），只重放尚未产生副作用的阶段",
        "provider 内建 5 次指数退避，仅在本次尝试还没有输出时重发",
        "会话 JSON + turn lease 单写者，$MICA_HOME 收拢 config / sessions / cache"
      ]
    },
    {
      "dot": "amber",
      "title": "扩展点与集成",
      "items": [
        "插件经 PluginContext 注册工具、hooks 与服务，TUI 与 headless 各有一套装配层",
        "mica-mcp 管理 server 生命周期，远端工具接入同一个 registry，断开即清理",
        "skills 只在 system prompt 里放索引，正文按需读取以保住 prompt cache 前缀"
      ]
    }
  ]
