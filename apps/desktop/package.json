{
  "name": "mica-code-app",
  "version": "1.0.0",
  "description": "Mica Code terminal app",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "icons:generate": "python3 scripts/generate-icons.py",
    "icons:sync": "bun scripts/sync-vscode-icons.mjs",
    "lint": "eslint --cache .",
    "test": "node ../../scripts/prune-test-temp.mjs && bun test src/host src/renderer/src src/main",
    "start": "electron-vite preview --ignoreConfigWarning",
    "dev": "npm run build:server && electron-vite dev --ignoreConfigWarning",
    "build": "node scripts/run-parallel.mjs \"npm run build:cli\" \"electron-vite build --ignoreConfigWarning\" \"vite build --config vite.server.config.mjs\"",
    "build:cli": "cd ../.. && bun run build",
    "build:app": "node scripts/run-parallel.mjs \"npm run build:cli\" \"electron-vite build --ignoreConfigWarning\"",
    "build:server": "vite build --config vite.server.config.mjs",
    "build:web": "npm run build",
    "start:web": "node out/server/index.mjs",
    "serve:web": "npm run build && node out/server/index.mjs",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w node-pty",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "//dependencies": "只放主进程 / 运行时真正会 require 的包：electron-builder 会把 dependencies 整份装进 app.asar，而 renderer 的依赖已经由 Vite 打进 out/renderer，留在 dependencies 里等于让安装包多背 200MB。新增 src/main 直接 require 的包时必须加在这里。",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.46.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
