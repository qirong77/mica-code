# Build-time runtime branding.
#
# Values here are compiled into the produced binary by `scripts/build.mjs`
# (injected via `bun build --define`). They control the externally visible
# runtime name, the default config directory, and the human-readable app
# label. Change them to rebrand a build without touching source code.
#
# Defaults match the upstream `mica` distribution, so unmodified builds
# behave exactly as before.

# Externally visible runtime/command name (used for CLI usage text).
MICA_RUNTIME_NAME=mica

# Machine-friendly version label emitted by `--version` (e.g. `mica-code 1.2.3`).
MICA_VERSION_LABEL=mica-code

# Human-readable product name shown in UI and plugin text.
MICA_APP_NAME=Mica Code

# Default config directory name under the user home (e.g. `~/.mica`).
# `MICA_HOME` still wins when explicitly set.
MICA_CONFIG_DIR_NAME=.mica
