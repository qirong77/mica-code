{
  "name": "mica-code",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:config-web": "vite build --config packages/mica-config-web/web/vite.config.ts && bun scripts/generate-config-web-assets.mjs",
    "build": "MICA_PREBUILD_DONE=1 bun scripts/build.mjs",
    "prebuild": "bunx tsc --noEmit",
    "postbuild": "bun scripts/install.mjs",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:model-rules": "bun scripts/update-model-rules.mjs",
    "update:model-rules:models-dev": "bun packages/mica-config/models-dev/update-model-rules.mjs",
    "format": "prettier --write AGENT.md README.md package.json tsconfig.json tsconfig.base.json .prettierrc \"src/**/*.{ts,tsx,js,jsx,mjs,json,md}\" \"packages/**/*.{ts,tsx,js,jsx,mjs,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,json,md}\" \"docs/**/*.md\" \"blogs/**/*.md\""
  },
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@anthropic/ink": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "latest",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "glob": "^13.0.6",
    "lucide-react": "^0.542.0",
    "lru-cache": "^11.2.4",
    "marked": "^18.0.3",
    "mitt": "^3.0.1",
    "nanostores": "^1.3.0",
    "openai": "^6.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-reconciler": "^0.33.0",
    "@types/turndown": "^5.0.6",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
