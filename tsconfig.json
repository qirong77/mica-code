{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@mica/llm": ["./src/llm/index.ts"],
      "@mica/llm/*": ["./src/llm/*"],
      "@anthropic/ink": ["./packages/@anthropic/ink/src/index.ts"],
      "@anthropic/ink/*": ["./packages/@anthropic/ink/src/*"]
    }
  },
  "include": ["src", "packages/@anthropic/ink"]
}
