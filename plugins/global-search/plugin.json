{
  "id": "global-search",
  "name": "Global Search",
  "version": "1.0.0",
  "description": "通过系统全局快捷键搜索配置目录中的文件和文件夹，在 Mica 编辑器中打开。",
  "icon": "search",
  "author": "Mica Code",
  "main": "index.ts",
  "assets": ["README.md"],
  "mica": { "apiVersion": 1 },
  "requires": [],
  "desktop": {
    "launcher": { "title": "Global Search", "shortcut": "Alt+Space", "width": 720, "height": 480 }
  },
  "settings": [
    {
      "key": "searchDirectories",
      "type": "textarea",
      "label": "搜索目录",
      "description": "一行一个目录，支持 ~/。搜索独立于当前会话和编辑器工作区。",
      "default": "~/Desktop\n~/Downloads"
    },
    {
      "key": "maxDepth",
      "type": "number",
      "label": "最大搜索深度",
      "description": "1 表示只搜索根目录及其直接子项。",
      "default": "1",
      "min": 1,
      "max": 16
    }
  ]
}
