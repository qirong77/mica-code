{
  "id": "mobile-relay",
  "name": "Mobile Relay",
  "icon": "smartphone",
  "version": "1.4.0",
  "description": "手机经一台公网中转机打开这台机器上的 Mica：同一份会话、同样的流式输出。本机只做短轮询，不开监听端口、不转发端口；轮询体单独用 AES-256-GCM 加密。中转机通过内置 skill 交给 agent 现场部署，插件只管本机这座桥。",
  "author": "Mica Code",
  "main": "index.ts",
  "assets": ["README.md", "skill/SKILL.md"],
  "priority": 40,
  "mica": { "apiVersion": 1 },
  "requires": ["settings", "tools", "background", "skills"],
  "desktop": {
    "panel": {
      "label": "手机访问",
      "roles": []
    }
  },
  "status": [
    { "key": "phoneUrl", "label": "手机链接", "type": "link" },
    { "key": "bridge", "label": "本机桥", "type": "text" },
    { "key": "relay", "label": "中转机", "type": "text" },
    { "key": "phone", "label": "手机", "type": "text" },
    { "key": "skill", "label": "部署 skill", "type": "link" }
  ],
  "settings": [
    {
      "key": "enabled",
      "label": "启用桥",
      "type": "switch",
      "default": "true",
      "description": "关掉会立刻停掉本机的桥进程，手机再也连不进来；不会留下还在外联的后台服务。"
    },
    {
      "key": "relayUrl",
      "label": "中转地址",
      "type": "text",
      "default": "",
      "required": true,
      "placeholder": "https://1-2-3-4.sslip.io",
      "description": "在插件面板里点「接入这台机器」会自动填好；手填则填中转机的公网地址，带 https://、不带末尾斜杠。"
    },
    {
      "key": "token",
      "label": "访问口令",
      "type": "password",
      "default": "",
      "required": true,
      "description": "由插件注册后自动写入，不用手工填；想换一台机器就回「手机访问」面板点「注册这台机器」。"
    }
  ]
}
