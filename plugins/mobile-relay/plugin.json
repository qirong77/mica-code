{
  "id": "mobile-relay",
  "name": "Mobile Relay",
  "icon": "message-square",
  "version": "1.1.0",
  "description": "手机经中转机打开这台机器上的 Mica（真实界面）：中转机托管页面并开窄 API，本机只做短轮询，不转发端口、不建常驻隧道。上行应用层加密，可限制开启时段并随机化间隔。",
  "author": "Mica Code",
  "main": "index.ts",
  "assets": ["README.md"],
  "priority": 40,
  "mica": { "apiVersion": 1 },
  "requires": ["settings", "tools", "background"],
  "settings": [
    {
      "key": "enabled",
      "label": "启用桥",
      "type": "switch",
      "default": "true"
    },
    {
      "key": "relayUrl",
      "label": "中转地址",
      "type": "text",
      "default": "",
      "placeholder": "https://1.2.3.4:9200"
    },
    {
      "key": "token",
      "label": "访问口令",
      "type": "password",
      "default": ""
    }
  ]
}
