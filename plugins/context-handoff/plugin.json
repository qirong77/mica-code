{
  "id": "context-handoff",
  "name": "Context Handoff",
  "version": "1.0.0",
  "description": "保存历史检查点，在稍后接手时提示重新核对工作区后继续。",
  "author": "Mica Code",
  "icon": "archive",
  "main": "index.ts",
  "assets": ["README.md"],
  "mica": {
    "apiVersion": 1
  },
  "requires": ["desktop", "session", "sessionState", "tools", "prompt", "settings"],
  "settings": [
    {
      "key": "telemetry",
      "label": "本地使用统计",
      "type": "switch",
      "default": "true",
      "hint": "仅记录交互事件与计数，不记录正文、路径、URL 或错误文本；不会上传。"
    },
    {
      "key": "ageMinutes",
      "label": "交接卡等待时间",
      "type": "number",
      "default": "30",
      "min": 1,
      "max": 10080,
      "unit": "分钟"
    }
  ],
  "desktop": {
    "panel": {
      "label": "Context Handoff",
      "display": "modal",
      "dynamicShortcuts": true
    }
  }
}
