    "sessionMenu": [
      { "label": "快速压缩", "action": "quick", "icon": "eraser", "position": "top", "surface": "chat" },
      { "label": "模型压缩", "action": "model", "icon": "sparkles", "position": "top", "surface": "chat" }
    ]
  },
  "llm": {
    "label": "压缩摘要模型",
    "description": "模型压缩用它把对话写成 checkpoint 摘要；快速压缩不调用模型。",
