{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@packages/*": ["./packages/*"],
      "@apps/*": ["./apps/*"],
      "@plugins/*": ["./plugins/*"],
      "@mica-config-ui/web": ["./packages/mica-config-ui/web/index.tsx"],
      "@mica-config-ui/*": ["./packages/mica-config-ui/*"]
    },
    "types": ["node", "bun"]
  }
}
